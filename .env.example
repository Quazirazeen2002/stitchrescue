# Existing Meta configuration. Never put keys in NEXT_PUBLIC variables.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-wonder-1.0
SAM_MODEL=sam-3.1
# Alternate META_API_BASE_URL and MUSE_WONDER_MODEL names are also supported.
# Generate a local manager credential: python -c "import secrets; print(secrets.token_urlsafe(32))"
MANAGER_APPROVAL_TOKEN=
FRONTEND_ORIGIN=http://localhost:3000
# Optional absolute paths. Defaults are project-local storage and SQLite.
# DATABASE_PATH=/absolute/path/to/storage/stitchrescue.db
# STORAGE_PATH=/absolute/path/to/storage
# Next.js server proxy target (also needed at production build time).
BACKEND_URL=http://127.0.0.1:8000
